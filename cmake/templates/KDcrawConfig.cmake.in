@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6Core @QT_MIN_VERSION@)
find_dependency(Qt6Gui @QT_MIN_VERSION@)

if (NOT @BUILD_SHARED_LIBS@)
    # add access to internal Find modules
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

    find_dependency(LibRaw @LIBRAW_MIN_VERSION@)

    # clean-up CMAKE_MODULE_PATH
    list(REMOVE_ITEM CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@KDCRAW_CMAKECONFIG_NAME@Targets.cmake")
